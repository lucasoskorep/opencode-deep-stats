{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-deep-stats",
  "version": "0.1.0",
  "description": "Deep analytics & GitHub PR velocity dashboard plugin for OpenCode (/deep-stats)",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Oskorep",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "stats",
    "analytics",
    "github",
    "tokens"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasoskorep/opencode-deep-stats.git"
  },
  "homepage": "https://github.com/lucasoskorep/opencode-deep-stats#readme",
  "bugs": {
    "url": "https://github.com/lucasoskorep/opencode-deep-stats/issues"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test --conditions=browser --preload @opentui/solid/preload",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@opencode/theme": "^2.3.0",
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.15",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "opencode": ">=2.0.0"
  }
}
